# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lj_spa?schema=public"

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_NAME="L&J Spa 2 Go Home"
# Public URL used to build absolute links (invites, reminders, receipts).
# Required in production behind a proxy/load balancer.
APP_URL="http://localhost:3000"

# --- Maps / Travel time provider (optional in dev) ---
# When unset, the app falls back to a straight-line-distance + average-speed
# estimator (src/lib/travel/haversine-provider.ts) clearly flagged as an estimate.
MAPS_PROVIDER="google" # google | mapbox | none
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_MAPS_PROVIDER="google"
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
MAPBOX_ACCESS_TOKEN=""

# --- Notifications (optional in dev; falls back to console/log provider) ---
SMS_PROVIDER="none" # none | twilio | semaphore
SMS_API_KEY=""
SMS_API_SECRET=""
EMAIL_PROVIDER="none" # none | resend | ses
EMAIL_API_KEY=""
EMAIL_FROM="noreply@ljspa2go.example"

# --- Payments (optional in dev; cash/manual always available) ---
PAYMENT_PROVIDER="manual" # manual | paymongo | stripe
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
